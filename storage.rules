rules_version = '2';
// Starter rules: signed-in users with verified emails can read /
// write any object. Replace with per-path checks (membership /
// owner / size / contentType) before shipping.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email_verified == true;
    }
  }
}
